{
  "name": "@avanio/logger-like",
  "version": "0.2.13",
  "description": "Logger like interface and tools",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.mts --minify --sourcemap --format cjs,esm --dts --clean",
    "test": "vitest test --run --coverage",
    "lint": "biome check",
    "validate": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "docs": "typedoc --options typedoc.json"
  },
  "files": [
    "dist"
  ],
  "repository": "github:mharj/logger-like",
  "keywords": [
    "logger"
  ],
  "author": "mharj",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tsconfig/node18": "^18.2.7",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "c8": "^12.0.0",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-dt-links": "^2.0.72",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
