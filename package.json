{
  "name": "@avanio/logger-like",
  "version": "0.2.13",
  "description": "Logger like interface and tools",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.mts --minify --sourcemap --format cjs,esm --dts --clean",
    "test": "vitest test --run --coverage",
    "lint": "biome check",
    "validate": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "docs": "typedoc --options typedoc.json"
  },
  "files": [
    "dist"
  ],
  "repository": "github:mharj/logger-like",
  "keywords": [
    "logger"
  ],
  "author": "mharj",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tsconfig/node18": "^18.2.6",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^10.1.3",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-dt-links": "^2.0.64",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.6.3+sha512.bb45e34d50a9a76e858a95837301bfb6bd6d35aea2c5d52094fa497a467c43f5c440103ce2511e9e0a2f89c3d6071baac3358fc68ac6fb75e2ceb3d2736065e6"
}
